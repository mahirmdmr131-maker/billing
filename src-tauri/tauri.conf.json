{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:3000",
    "distDir": "../dist"
  },
  "package": {
    "productName": "AM Food Manager",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": true
    },
    "bundle": {
      "active": true,
      "category": "Business",
      "copyright": "A M Food Processing",
      "externalBin": [],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "identifier": "com.amfoodprocessing.manager",
      "longDescription": "A complete business management suite for A M Food Processing.",
      "shortDescription": "Business Manager",
      "targets": "all",
      "windows": [
        {
          "fullscreen": false,
          "resizable": true,
          "title": "A M Food Processing Manager",
          "width": 1200,
          "height": 800,
          "minWidth": 800,
          "minHeight": 600
        }
      ]
    },
    "security": {
      "csp": null
    },
    "updater": {
      "active": false
    }
  }
}